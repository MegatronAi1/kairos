# Copy to .env and fill in. Names only; never commit values.

# AWS (us-east-1 only). Prefer an AWS profile or instance role over raw keys.
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Bedrock model / inference profile IDs (discover with `aws bedrock list-inference-profiles --region us-east-1`)
KAIROS_MODEL_CHAT=
KAIROS_MODEL_FAST=
KAIROS_BEDROCK_MAX_RPS=0.8

# Backend
KAIROS_API_TOKEN=
KAIROS_CORS_ORIGINS=http://localhost:5173
KAIROS_ARTIFACTS_DIR=artifacts
KAIROS_DATA_DIR=data
KAIROS_SCENARIO=investor_demo

# Web (Vite)
VITE_API_BASE=http://localhost:8000
VITE_API_TOKEN=
